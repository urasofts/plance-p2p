# Copia este archivo a .env y llena tus propios valores.
# .env NUNCA se sube al repositorio (ya está en .gitignore).

# ── Base de datos ──
# Con XAMPP: DB_USER=root y DB_PASS= (vacío)
# Con MySQL standalone: usa el usuario/clave que configuraste al instalar
DB_HOST=localhost
DB_PORT=3306
DB_NAME=place_bsd
DB_USER=root
DB_PASS=

# ── URL base del proyecto (para el returnUrl de PlaceToPay) ──
# Con php -S deja este valor. Si cambias de puerto, ajústalo aquí.
APP_BASE_URL=http://localhost:8000

